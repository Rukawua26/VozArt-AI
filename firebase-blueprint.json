{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil del artista y configuración personalizada de Google AI Studio",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "Nombre visible del artista" },
        "email": { "type": "string", "description": "Correo de Google / Gmail" },
        "photoURL": { "type": "string", "description": "Avatar del artista" },
        "aiStudioKey": { "type": "string", "description": "Clave opcional de Google AI Studio del usuario" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Fecha de creación" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Fecha de actualización" }
      },
      "required": ["displayName", "email"]
    },
    "Artwork": {
      "title": "Artwork",
      "description": "Obra de arte y lienzo guardado en la nube por el usuario",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID del usuario propietario" },
        "title": { "type": "string", "description": "Título de la obra de arte" },
        "canvasJson": { "type": "string", "description": "Serialización completa de Fabric.js JSON" },
        "previewUrl": { "type": "string", "description": "URL o base64 de miniatura PNG" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Fecha de creación" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Fecha de última modificación" }
      },
      "required": ["userId", "title", "canvasJson"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Documentos privados de cada usuario autenticado"
    },
    "/artworks/{artworkId}": {
      "schema": "Artwork",
      "description": "Lienzos y obras almacenadas por artistas"
    }
  }
}
